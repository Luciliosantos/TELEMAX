# ============================================================
# TELEMAX - variaveis de ambiente (NUNCA comitar valores reais)
# Copie para .env e preencha os segredos
# ============================================================

# Modo: development | production
FLASK_ENV=production
SECRET_KEY=troque-por-uma-chave-longa-aleatoria
BASE_URL=https://telemax.lsnet.shop

# Banco de dados (arquivo SQLite)
DATABASE_PATH=instance/telemax.db

# Sessoes
SESSION_LIFETIME_HOURS=168

# Uploads (bytes)
MAX_UPLOAD_BYTES=2097152

# Gateway Pix: demo (apenas desenvolvimento/sandbox) | mercadopago (producao)
PIX_PROVIDER=demo
PIX_WEBHOOK_SECRET=troque-por-um-segredo-forte

# Mercado Pago (producao) - criar conta em https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail (recuperacao de senha). Em dev, EMAIL_BACKEND=console imprime o link no log.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contato@telemax.lsnet.shop

# Administrador inicial: crie com "python scripts/create_admin.py" (nunca senha padrao)
